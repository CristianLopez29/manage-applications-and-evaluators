# Production environment template for a VPS deploy.
# Copy to .env on the server, fill in every <...> placeholder, then generate the
# key with:
#   docker compose -f compose.prod.yaml run --rm app php artisan key:generate --show
#
# Never commit the filled-in file: .env is gitignored, .env.production is too.
#
# Hostnames below are Docker Compose service names, resolved on the app's private
# `internal` network. Neither MySQL nor Redis is reachable from outside it.

APP_NAME="Candidacy Management API"
APP_ENV=production

# The hostname Traefik routes to this app. Its A record must already point at
# the VPS before the container starts, or the TLS challenge fails.
APP_DOMAIN=<your-domain>
APP_KEY=
APP_DEBUG=false
APP_URL=https://<your-domain>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Structured JSON to a rotated file, plus stderr — which is what `docker logs`
# and any log driver you point at the container will collect.
LOG_CHANNEL=production
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=14
LOG_ACCESS_DAYS=7

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=candidacy
DB_USERNAME=candidacy
DB_PASSWORD=<strong-password>
# Only used by the mysql container to initialise itself; the app never uses it.
DB_ROOT_PASSWORD=<another-strong-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=<redis-password>
REDIS_PORT=6379

# Real SMTP: Mailpit is a local-only capture tool and sends nothing.
MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@<your-domain>"
MAIL_FROM_NAME="${APP_NAME}"

# Bearer tokens expire after 60 minutes.
SANCTUM_EXPIRATION=60

# Required: /api/health and /api/readiness fail closed (403) without it.
# Generate one with: openssl rand -hex 32
HEALTHCHECK_TOKEN=<random-32-byte-hex>

# Swagger UI stays behind an admin bearer token because APP_ENV is not local.
# Set to false only if you deliberately want the docs public.
L5_SWAGGER_PROTECT=true
L5_SWAGGER_CONST_HOST="https://<your-domain>"
L5_SWAGGER_GENERATE_ALWAYS=false

# Comma-separated browser origins allowed to call the API.
# Leave empty if there is no browser front-end; curl and server-to-server
# callers are unaffected by CORS.
CORS_ALLOWED_ORIGINS=

# Leave empty to disable error reporting. When set, unhandled exceptions are
# sent to Sentry; domain exceptions (4xx business outcomes) are excluded.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0

# Telescope is a dev dependency and is not registered outside local.
TELESCOPE_ENABLED=false

AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash-lite
# Hard ceiling on billed AI calls per day and on the AI response size, regardless of
# who is calling. This is a public portfolio demo — keep it low. See config/ai.php.
AI_DAILY_CALL_BUDGET=20
AI_MAX_OUTPUT_TOKENS=500
RUN_AI_INTEGRATION_TESTS=false

# Days an assignment may stay overdue before the scheduler escalates it.
OVERDUE_ESCALATION_DAYS=3
