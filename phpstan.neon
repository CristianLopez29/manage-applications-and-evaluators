includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - src/
        - tests/

    # Level 9 is the highest level
    level: 9

    ignoreErrors:
        - '#Called .env. outside of the config directory#'

    excludePaths:
        #- ./*/*/FileToBeExcluded.php
