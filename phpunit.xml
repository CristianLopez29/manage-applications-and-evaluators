<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Candidates">
            <directory>tests/Candidates</directory>
        </testsuite>
        <testsuite name="Evaluators">
            <directory>tests/Evaluators</directory>
        </testsuite>
        <testsuite name="Auth">
            <directory>tests/Auth</directory>
        </testsuite>
        <testsuite name="Security">
            <directory>tests/Security</directory>
        </testsuite>
        <testsuite name="Shared">
            <directory>tests/Shared</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
            Pinned on purpose. The consolidated evaluators query is raw MySQL
            (GROUP_CONCAT ... ORDER BY ... SEPARATOR) and the assignment lock is a real
            SELECT ... FOR UPDATE, so SQLite would either fail to parse the query or
            silently skip the locking this suite is meant to cover. Without this line the
            engine is whatever .env happens to say.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="database"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
